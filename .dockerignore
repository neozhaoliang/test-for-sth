# Build an image WITH the versioned research data/ directory.
# Never package credentials or saved authenticated browser sessions.
.git
.env
.env.*
!.env.example
browser_data/
logs/
instance/
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
node_modules/
temp_image/
tmp/
*.zip
*.tar
*.sqlite3
*.db
# Include SQLite snapshots when they live under the requested data/ tree.
!data/*.sqlite3
!data/*.db
!data/**/*.sqlite3
!data/**/*.db
dist/
build/
.idea/
.vscode/
docker.env
