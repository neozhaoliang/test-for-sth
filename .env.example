# Proxy Configuration (Kuaidaili)
# your_kuaidaili_secret_id
KDL_SECERT_ID=
# your_kuaidaili_signature
KDL_SIGNATURE=
# your_kuaidaili_username
KDL_USER_NAME=
# your_kuaidaili_password
KDL_USER_PWD=

# Proxy Configuration (Jisu HTTP)
# Get JiSu HTTP IP extraction key value
jisu_key=
# Get JiSu HTTP IP extraction encryption signature
jisu_crypto=

# Investment Agent / DeepSeek Anthropic-compatible endpoint
# The new V4 Flash API accepts a maximum of 384K = 393216 output tokens.
# max_tokens is a ceiling, NOT a prepaid token allowance.
# Ignored for official Anthropic or other non-DeepSeek endpoints.
# Lower to 65536/131072 for faster, cheaper routine JSON extraction if desired.
# BACKTEST_LLM_MAX_TOKENS=393216
# BACKTEST_LLM_MODEL=deepseek-flash
# ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
# ANTHROPIC_AUTH_TOKEN=<put-token-in-your-private-.env>
